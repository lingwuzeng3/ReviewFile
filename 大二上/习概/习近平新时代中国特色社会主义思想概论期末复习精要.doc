p.MsoNormal{
mso-style-name:正文;
mso-style-parent:"";
margin:0pt;
margin-bottom:.0001pt;
text-align:left;
font-family:宋体;
font-size:12.0000pt;
}

h1{
mso-style-name:"标题 1";
mso-style-next:正文;
margin-top:5.0000pt;
margin-bottom:15.0000pt;
mso-margin-top-alt:auto;
text-align:center;
font-family:宋体;
color:rgb(204,0,0);
font-weight:bold;
font-size:12.0000pt;
mso-font-kerning:22.0000pt;
}

h2{
mso-style-name:"标题 2";
mso-style-noshow:yes;
mso-style-next:正文;
margin-top:12.5000pt;
margin-bottom:5.0000pt;
mso-margin-bottom-alt:auto;
border-bottom:1.0000pt solid rgb(221,221,221);
mso-border-bottom-alt:0.5000pt solid rgb(221,221,221);
padding:0pt 0pt 2pt 0pt ;
text-align:left;
font-family:宋体;
color:rgb(204,0,0);
font-weight:bold;
font-size:10.0000pt;
}

h3{
mso-style-name:"标题 3";
mso-style-noshow:yes;
